# Reportes CSV generados en tiempo de ejecucion
reportes/

# OS metadata
Thumbs.db
.DS_Store

# Artefacto generado por maven-shade-plugin
web/dependency-reduced-pom.xml

# Config local del preview tool (rutas absolutas de la maquina)
.claude/launch.json
